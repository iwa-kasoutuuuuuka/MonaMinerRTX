# ==============================================================================
# Monacoin Core Node Configuration for MonaMinerRTX Solo Mining
# ==============================================================================

# Enable JSON-RPC server
server=1
listen=1
daemon=0

# RPC Credentials
# "rpcpassword" below is only a placeholder. MonaMinerRTX copies this template to monacoin.conf
# on its first launch and replaces the placeholder with a random password of its own
# (v2.2.3+), and uses that password for solo mining. Do not put a real password in the template.
rpcuser=monacoinrpc
rpcpassword=rpcpassword

# RPC Port (Default: 9402)
rpcport=9402

# Allowed IP addresses for RPC calls (Localhost only for security)
rpcallowip=127.0.0.1
rpcallowip=::1

# High performance memory cache for rapid blockchain sync (in megabytes)
dbcache=4096

# Fallback transaction fee
fallbackfee=0.0001

# Transaction index (optional, beneficial for block explorers and wallet checks)
txindex=1
